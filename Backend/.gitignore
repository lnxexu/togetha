# Backend-specific gitignore additions

# Django specific
staticfiles/
static_root/
collectstatic/
.coverage
htmlcov/
.pytest_cache/

# Celery specific
celerybeat-schedule
celerybeat.pid

# Email debug files (you already have email_debug.log in your backend)
*.eml
email_debug.log

# Test databases
test_*.sqlite3
test_*.db

# Django migrations (optional - some teams prefer to ignore these)
# */migrations/0*.py
# !*/migrations/__init__.py

# Virtual environment (if created inside Backend/)
venv/
env/
.venv/

# Python cache
__pycache__/
*.pyc
*.pyo

# Environment files - NEVER commit these to git
.env
.env.local
.env.*.local
*.key
*.pem

# IDE files
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# SQLite databases (not persistent on Render)
*.sqlite3
*.db

# Media files (should use cloud storage in production)
media/