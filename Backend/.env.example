# Django Security Settings
SECRET_KEY=your-secret-key-here-generate-a-new-one
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,your-render-domain.onrender.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-frontend-domain.com
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-frontend-domain.com

# Email Configuration (SendGrid SMTP)
# For SendGrid SMTP, USERNAME MUST BE 'apikey' and PASSWORD is your SendGrid API key.
# Do NOT set EMAIL_HOST_USER to your personal email when using SendGrid SMTP.
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=apikey
SENDGRID_API_KEY=your-sendgrid-api-key
# Optionally set explicitly; otherwise settings will read from SENDGRID_API_KEY
EMAIL_HOST_PASSWORD=
# Sender address seen by recipients
EMAIL_FROM=your-email@your-domain.com
DEFAULT_FROM_EMAIL=your-email@your-domain.com

# Email transport options
# Prefer Web API (HTTPS) over SMTP to avoid blocked SMTP ports in some hosts
EMAIL_PREFER_SENDGRID_API=False
# Whether to try SSL (port 465) after TLS 587; disable to avoid 465 timeouts
EMAIL_SMTP_TRY_SSL=True
# Disable SendGrid Web API completely (use SMTP only). Helpful if SendGrid IP Access Management blocks API.
EMAIL_DISABLE_SENDGRID_API=False

# Optional: an explicitly verified sender to fall back to when your default FROM fails Sender Identity checks
# Example: SENDGRID_FALLBACK_FROM=no-reply@verified.your-domain.com
SENDGRID_FALLBACK_FROM=

# Database (for local development only - Render uses DATABASE_URL)
DB_PASSWORD=your-local-db-password

# Google Generative AI (Gemini)
# Obtain a key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key
# Primary chat model (non-streaming). Example: gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash

# Ordered chat model candidates for graceful fallback (CSV)
# If the first model is unavailable due to quota/rate or not found, the backend will try the next.
# Leave empty to use defaults from settings.py
GEMINI_MODEL_CANDIDATES=gemini-2.5-flash,gemini-2.5-flash-lite,gemini-2.5-flash-lite-preview,gemini-2.0-flash,gemini-2.0-flash-lite

# Embeddings configuration
EMBEDDING_MODEL=text-embedding-004
# Ordered embedding model candidates for fallback (CSV). Leave empty to use defaults.
EMBEDDING_MODEL_CANDIDATES=text-embedding-004,embedding-001

# Redis
# Prefer split URLs. The app will fall back to REDIS_URL if these aren't set.
# Local (non-TLS):
REDIS_BROKER_URL=redis://localhost:6379/0
REDIS_CACHE_URL=redis://localhost:6379/1
# If your provider requires TLS, use rediss:// and the app will enable SSL automatically:
# REDIS_BROKER_URL=rediss://:password@your-host:your-port/0
# REDIS_CACHE_URL=rediss://:password@your-host:your-port/1

# Compatibility: If only REDIS_URL is set, it's used for both broker and cache.
# Example:
# REDIS_URL=redis://localhost:6379/1

# Railway-specific tips (optional):
# If Railway exposes these variables, the app can derive URLs automatically when
# REDIS_BROKER_URL/REDIS_CACHE_URL are not set:
#   REDIS_PUBLIC_URL, REDISHOST, REDISPORT, REDIS_PASSWORD (or REDISPASSWORD)