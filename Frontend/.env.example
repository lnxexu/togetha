# API Configuration - Copy this to .env and fill in your actual values
# DO NOT COMMIT .env files to version control!

# Main API URL - Your Django backend
EXPO_PUBLIC_API_URL=http://localhost:8000

# Google OAuth Configuration
# Get these from Google Cloud Console: https://console.cloud.google.com/
# 1. Create a new project or select existing one
# 2. Enable Google+ API and OAuth consent screen
# 3. Create OAuth 2.0 Client IDs for each platform

# Web Client ID (Required for backend verification)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_google_web_client_id_here.googleusercontent.com

# iOS Client ID (Optional - auto-detected if not provided)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your_google_ios_client_id_here.googleusercontent.com

# Client Secret (Required for web auth flow)
EXPO_PUBLIC_GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Environment type (development, staging, production)
EXPO_PUBLIC_ENVIRONMENT=development

# Debug mode
EXPO_PUBLIC_DEBUG=true

JAVA_HOME = "C:\Program Files\Java\jdk-17"

ANDROID_HOME = "C:\Users\[USERNAME]\AppData\Local\Android\Sdk"
